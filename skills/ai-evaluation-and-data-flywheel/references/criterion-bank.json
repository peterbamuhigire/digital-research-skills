        "freshness_state",
        "dependent_claim_ids"
      ]
    },
    {
      "id": "domain_controls_when_required",
      "version": "0.1.0",
      "owner": "source-evaluation and domain engine",
      "guidance_path": "skills/source-evaluation/SKILL.md",
