        "priority",
        "decision"
      ],
      "required_evidence": [
        "claim_ids",
        "source_ids",
        "ordering_reason"
      ],
      "boundary": "Retrieval or presentation order does not establish authority."
    },
    {
      "id": "information_value",
      "paper_criterion": "InformationValueCheck",
      "version": "0.1.0",
      "owner": "critical-reasoning-and-argument",
      "guidance_path": "skills/critical-reasoning-and-argument/SKILL.md",
      "guidance_sha256": "5AFBE65AA28A01C1A16404886A07E9E79DC69D7249E273FEF052839EDEE1F99D",
      "trigger_tags": [
        "multi_source",
        "long_packet",
        "synthesis"
      ],
      "required_evidence": [
        "distinct_propositions",
        "source_links"
      ],
      "boundary": "Do not remove repeated wording when it carries distinct evidence."
    },
    {
      "id": "factual_reliability",
      "paper_criterion": "FactualReliabilityCheck",
      "version": "0.1.0",
      "owner": "source-verification",
      "guidance_path": "skills/source-verification/SKILL.md",
      "guidance_sha256": "F9E9D0CDE365F44A7662BAB481BC5325287EF9846163BA2C9802D6DA74961425",
      "trigger_tags": [
        "claim",
        "citation",
        "number",
        "law",
        "policy"
      ],
      "required_evidence": [
        "claim_ids",
        "source_ids",
        "locators",
        "support_state"
      ],
      "boundary": "Packet assessment never substitutes for exact claim verification."
    },
    {
      "id": "risk_compliance",
      "paper_criterion": "RiskComplianceCheck",
      "version": "0.1.0",
      "owner": "source-evaluation and domain engine",
      "guidance_path": "skills/source-evaluation/SKILL.md",
      "guidance_sha256": "64F91C3D2B819E6009039DB2118E6C504DF39F5CBB4F15E525B94144B0163859",
      "trigger_tags": [
        "tax",
        "legal",
        "safety",
        "privacy",
        "financial",
        "regulated"
      ],
      "required_evidence": [
        "risk_class",
        "control_ids",
        "review_state"
      ],
      "boundary": "Applicable domain controls are mandatory and cannot be probabilistically omitted."
    },
    {
      "id": "source_independence",
      "paper_criterion": "SourceDiversityCheck",
      "version": "0.1.0",
      "owner": "source-evaluation",
      "guidance_path": "skills/source-evaluation/references/credibility-ladder.md",
      "guidance_sha256": "017D6C675820EE4BCF70ADD9BF72ECA756BF0B6EC05872922B2FF31CCCE8E026",
