      ],
      "required_evidence": [
        "source_ids",
        "origin_cluster_ids"
      ],
      "boundary": "Copied or syndicated sources do not count as independent corroboration."
    },
    {
      "id": "template_duplication",
      "paper_criterion": "TemplateDuplication",
      "version": "0.1.0",
      "owner": "ai-evaluation-and-data-flywheel",
      "guidance_path": "skills/ai-evaluation-and-data-flywheel/SKILL.md",
      "guidance_sha256": "AEC2C25296F337CBAE42D458A000A2A2B530C9BE0392B14729D817E06E0AC8EB",
      "trigger_tags": [
        "multi_source",
        "long_packet",
        "duplicate"
      ],
      "required_evidence": [
        "origin_clusters",
        "claim_ids",
        "duplication_basis"
      ],
      "boundary": "A shared origin is a dependence signal, not proof every item is identical."
    },
    {
      "id": "subquestion_coverage",
      "paper_criterion": "SubIntentCoverageCheck",
      "version": "0.1.0",
      "owner": "research-orchestration",
      "guidance_path": "skills/research-orchestration/SKILL.md",
      "guidance_sha256": "456E8752DF6A68901BE54D14194B513C01B088D62C56A02606C5C49538C5B9D8",
      "trigger_tags": [
        "multi_part",
        "recommendation",
        "countercase",
        "decision"
      ],
      "required_evidence": [
        "required_subquestion_ids",
        "covered_subquestion_ids",
        "gap_ids"
      ],
      "boundary": "An uncovered question remains a gap; do not infer an answer."
    },
    {
      "id": "claim_appropriate_authority",
      "paper_criterion": "SourceAuthorityCheck",
      "version": "0.1.0",
      "owner": "source-evaluation",
      "guidance_path": "skills/source-evaluation/SKILL.md",
      "guidance_sha256": "64F91C3D2B819E6009039DB2118E6C504DF39F5CBB4F15E525B94144B0163859",
      "trigger_tags": [
        "expertise",
        "legal",
        "technical",
        "statistical",
        "claim"
      ],
      "required_evidence": [
        "claim_ids",
        "source_ids",
        "authority_basis"
      ],
      "boundary": "Authority is claim-specific; official status is not infallibility."
    },
    {
      "id": "method_expertise_fit",
      "paper_criterion": "EvidenceProfessionalism",
      "version": "0.1.0",
      "owner": "source-verification and domain reviewer",
      "guidance_path": "skills/source-verification/SKILL.md",
      "guidance_sha256": "F9E9D0CDE365F44A7662BAB481BC5325287EF9846163BA2C9802D6DA74961425",
      "trigger_tags": [
        "technical",
        "statistical",
        "legal",
        "causal"
      ],
      "required_evidence": [
        "method",
        "claim_ids",
        "reviewer_basis"
      ],
      "boundary": "The adapter cannot replace qualified professional review."
    },
    {
      "id": "evidence_complementarity",
      "paper_criterion": "HeterogeneousFulfillment",
      "version": "0.1.0",
      "owner": "evidence-claim-graph",
      "guidance_path": "skills/evidence-claim-graph/references/graph-schema.md",
      "guidance_sha256": "2DCBDE74D4BE241B3C9AF057522D8F0BD0A779F6D312033970C5DCD6E6E24500",
      "trigger_tags": [
        "multi_source",
        "mixed_evidence",
        "decision"
      ],
      "required_evidence": [
        "evidence_type",
        "claim_ids",
        "distinct_role"
      ],
      "boundary": "Different source types matter only when they support distinct decision needs."
    }
  ]
}
