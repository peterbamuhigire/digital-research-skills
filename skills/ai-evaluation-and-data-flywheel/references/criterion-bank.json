    "safe_minimum": [
      "decision_fit",
      "information_value"
    ],
    "empty_or_unknown_tags": "select-safe-minimum-and-mark-not-assessed",
    "mandatory_guard_ids": [
      "instruction_data_separation",
      "source_provenance",
