        "no_embedded_instruction_authority"
      ]
    },
    {
      "id": "source_provenance",
      "version": "0.1.0",
      "owner": "source-evaluation",
      "guidance_path": "skills/source-evaluation/references/evidence-discipline.md",
      "guidance_sha256": "91D1CA3BEEC6DFF3A71142545655F1F9F7D59BA13AB76FE4EFFE9A015095DBBE",
