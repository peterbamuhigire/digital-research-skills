      "required_evidence": [
        "control_id",
        "scope",
        "review_state"
      ]
    }
  ],
  "criteria": [
    {
      "id": "decision_fit",
      "paper_criterion": "MainIntentMatch",
      "version": "0.1.0",
      "owner": "research-orchestration",
      "guidance_path": "skills/research-orchestration/SKILL.md",
      "guidance_sha256": "456E8752DF6A68901BE54D14194B513C01B088D62C56A02606C5C49538C5B9D8",
      "trigger_tags": [
        "decision",
        "question",
        "scope"
      ],
      "required_evidence": [
        "question",
        "decision",
        "scope"
      ],
      "boundary": "Do not invent a decision or widen the supplied scope."
    },
    {
      "id": "decision_usefulness",
      "paper_criterion": "TaskNeedSatisfaction",
      "version": "0.1.0",
      "owner": "critical-reasoning-and-argument",
      "guidance_path": "skills/critical-reasoning-and-argument/SKILL.md",
      "guidance_sha256": "5AFBE65AA28A01C1A16404886A07E9E79DC69D7249E273FEF052839EDEE1F99D",
      "trigger_tags": [
        "decision",
        "recommendation",
        "action"
      ],
      "required_evidence": [
        "decision",
        "finding_ids",
        "implications"
      ],
      "boundary": "Usefulness is not evidence truth or release authority."
    },
    {
      "id": "evidence_prominence",
      "paper_criterion": "RankingFaithfulness",
      "version": "0.1.0",
      "owner": "evidence-claim-graph",
      "guidance_path": "skills/evidence-claim-graph/SKILL.md",
      "guidance_sha256": "D4A330DC7FA90B81013375853522220E547DA081D6C310CF460CFD5DA477D0CB",
